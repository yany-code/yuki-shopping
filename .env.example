# 复制本文件为 .env 并填入真实值：cp .env.example .env
# 规则：KEY=VALUE 等号两侧不要加空格和引号；docker-compose 与 Spring 应用共用同一个 .env

# MySQL root 密码（仅 docker 容器健康检查使用）
MYSQL_ROOT_PASSWORD=changeit-root
# 应用连接 MySQL 的密码（容器 MYSQL_PASSWORD 与 Spring datasource 共用）
DB_PASSWORD=changeit-db

# Redis 密码（容器 requirepass/健康检查与 Spring data.redis 共用）
REDIS_PASSWORD=changeit-redis

# JWT 签名密钥（HS256 需至少 32 字节；生成：openssl rand -hex 32）
JWT_SECRET=replace-with-openssl-rand-hex-32
